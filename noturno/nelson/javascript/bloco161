// Declara uma função tradicional chamada "hello" sem nenhum parâmetro.
function hello (){
 // Imprime a palavra 'Oi' no console quando a função é chamada.
 console.log ('Oi')
 }

// Chama a função "hello()" sem passar argumentos. Ela exibirá 'Oi'.
hello()

// Cuidado: em JavaScript, se você declarar outra função com o mesmo nome, 
// a nova definição substitui (redefine) a anterior.
function hello (nome){
// Esta nova versão da função "hello" agora espera receber um parâmetro chamado "nome".
console.log ('Hello, ' + nome)
}

// Chama a nova versão da função "hello" passando a string 'Pedro' como argumento.
// O resultado impresso será 'Hello, Pedro'.
hello('Pedro')

// Declara uma função tradicional chamada "soma" que recebe dois parâmetros: "a" e "b".
 function soma (a, b) {
 // Retorna a soma aritmética dos dois valores recebidos.
 return a + b;
 }

// Chama a função "soma" passando os números 2 e 3 como argumentos, 
// e armazena o valor retornado (5) em uma constante chamada "res".
 const res = soma (2, 3)

// Exibe o valor armazenado na constante "res" (que é 5) no console.
 console.log (res)